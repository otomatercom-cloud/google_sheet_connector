<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Odoo 19: <list> replaces <tree> -->
    <record id="view_google_sheet_sync_log_list" model="ir.ui.view">
        <field name="name">google.sheet.sync.log.list</field>
        <field name="model">google.sheet.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs"
                  decoration-danger="status == 'error'"
                  decoration-warning="status == 'warning'"
                  decoration-success="status == 'success'">
                <field name="connection_id"/>
                <field name="sync_date"/>
                <field name="records_created" string="Created"/>
                <field name="records_updated" string="Updated"/>
                <field name="records_skipped" string="Skipped"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-warning="status == 'warning'"
                       decoration-danger="status == 'error'"/>
                <field name="message" string="Details" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_google_sheet_sync_log_form" model="ir.ui.view">
        <field name="name">google.sheet.sync.log.form</field>
        <field name="model">google.sheet.sync.log</field>
        <field name="arch" type="xml">
            <!-- Odoo 19: create/edit attrs removed; use access control instead -->
            <form string="Sync Log">
                <sheet>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="sync_date"/>
                            <field name="status" widget="badge"/>
                        </group>
                        <group>
                            <field name="records_created"/>
                            <field name="records_updated"/>
                            <field name="records_skipped"/>
                        </group>
                    </group>
                    <field name="message" widget="text" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_google_sheet_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">google.sheet.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
